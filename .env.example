PORT=3140
# Optional device target. Discovery is performed only when requested in the editor.
COREBAR_HOST=
# TrueNAS SCALE 25.10 JSON-RPC endpoint. TLS verification stays enabled.
TRUENAS_URL=wss://nas.example.com/api/current
TRUENAS_API_KEY=
TRUENAS_NAME=TrueNAS
# Optional exact core name, e.g. cpu0. Empty uses hottest available CPU core.
TRUENAS_SENSOR=
# Export your local CA and set NODE_EXTRA_CA_CERTS=/absolute/path/ca.pem if needed.
BESZEL_URL=https://beszel.example.com
# Existing PocketBase user token with read access to this system's records.
BESZEL_TOKEN=
BESZEL_SYSTEM_ID=
BESZEL_NAME=Beszel
# Exact sensor key from stats.t. Empty leaves temperature unavailable.
BESZEL_SENSOR=

# Existing exported .umpf file. Edits use a private copy; the original is unchanged.
NATIVE_PROJECT_FILE=
